# Copy this to .env.local and fill in your own values.

# Disable telemetry for faster builds
NEXT_TELEMETRY_DISABLED=1

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_key_here
CLERK_SECRET_KEY=your_clerk_secret_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Gemini — powers the dashboard deep dive and the in-app assistant.
# Get a free key at https://aistudio.google.com/apikey
# Server-only: no NEXT_PUBLIC_ prefix, so it is never sent to the browser.
GEMINI_API_KEY=your_gemini_key_here
# Optional, defaults to gemini-3.5-flash-lite (free tier). Note that
# gemini-2.0-flash and gemini-2.5-flash are no longer usable on new free keys.
# GEMINI_MODEL=gemini-3.5-flash

# Neon / Postgres connection string
NEXT_PUBLIC_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
